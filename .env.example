# SearXNG instance URL (required)
SEARXNG_URL=https://search.wze.nope.at
# Request timeout in milliseconds (default 10000)
SEARXNG_TIMEOUT_MS=10000
# Verbose stderr logging (search requests, AI loop, tool use); 0 disables
# WEB_SEARCH_DEBUG=1

