# SearXNG instance URL (required)
SEARXNG_URL=https://search.wze.nope.at
# Request timeout in milliseconds (default 10000)
SEARXNG_TIMEOUT_MS=10000
# Verbose stderr logging (search requests, AI loop, tool use); 0 disables
# WZE_WEBSEARCH_DEBUG=1
# Display cap for markdown summaries/overviews (default 15); never truncates
# the persisted session
# WZE_WEBSEARCH_MAX_RESULTS=15
# Budget for the --use-ai summarizer's follow-up search tool calls per answer
# (default 10); exhausted -> "search volume exhausted" (HTTP 429)
# WZE_WEBSEARCH_MAX_AGENT_SEARCHES=10
# LangChain graph recursion cap for the --use-ai summarizer
# (default: maxModelCalls * 4 + 10 = 50)
# WZE_WEBSEARCH_RECURSION_LIMIT=50

# Optional OpenAI-compatible endpoint for the later LangChain agentic phase
# OPENAI_BASE_URL=https://litellm.void.cold.at/v1
# OPENAI_MODEL=deepseek-v4-flash
# OPENAI_API_KEY=sk-...