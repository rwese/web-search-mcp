{
  "name": "@rwese/wze-websearch",
  "version": "0.8.1",
  "private": true,
  "license": "MIT",
  "author": "rwese",
  "type": "module",
  "description": "Agent-agnostic web search: a SearXNG-backed search core shared by a CLI, an MCP server, and a pi extension wrapper.",
  "homepage": "https://git.void.cold.at/ai-factory/wze-websearch",
  "repository": {
    "type": "git",
    "url": "ssh://git@git.void.cold.at:3022/ai-factory/wze-websearch.git"
  },
  "bugs": {
    "url": "https://git.void.cold.at/ai-factory/wze-websearch/issues"
  },
  "keywords": [
    "pi-package",
    "web-search",
    "wze-websearch",
    "searxng",
    "mcp",
    "model-context-protocol"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/surfaces/mcp/mcp.d.ts",
      "default": "./dist/surfaces/mcp/mcp.js"
    },
    "./pi-tool": {
      "types": "./dist/surfaces/pi/tool.d.ts",
      "default": "./dist/surfaces/pi/tool.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "wze-websearch": "./dist/surfaces/cli/cli.js",
    "wze-websearch-mcp": "./dist/surfaces/mcp/mcp.js"
  },
  "files": [
    "dist",
    "extensions",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "peerDependenciesMeta": {
    "@mariozechner/pi-coding-agent": {
      "optional": true
    },
    "@mariozechner/pi-tui": {
      "optional": true
    }
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/openai": "^1.5.11",
    "@modelcontextprotocol/sdk": "1.30.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "langchain": "^1.5.10",
    "tar": "^7.5.22",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@mariozechner/pi-coding-agent": "^0.73.0",
    "@mariozechner/pi-tui": "^0.73.0",
    "@sinclair/typebox": "^0.34.52",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "^9.0.0",
    "fallow": "^3.32.0",
    "globals": "^17.5.0",
    "prettier": "^3.4.0",
    "typescript": "^5.8.0",
    "vitest": "^2.1.9"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ extensions/",
    "lint:fix": "eslint src/ extensions/ --fix",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "format": "prettier --write src/ extensions/",
    "typecheck": "tsgo -p tsconfig.json",
    "build": "rm -rf dist && tsgo -p tsconfig.build.json && chmod +x dist/surfaces/cli/cli.js dist/surfaces/mcp/mcp.js",
    "validate": "npm run typecheck && npm run lint && npm run fallow && npm run test"
  }
}
